# Multi-stage build: keep the runtime image lean by not shipping build tools.
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps needed to build a couple of the scientific-python wheels on
# some platforms; kept minimal on purpose.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# Skip the (optional, heavy) sentence-transformers line for the default
# container image -- TF-IDF backend is used unless the image is rebuilt
# with that line uncommented and EMBEDDING_BACKEND=sentence-transformers set.
RUN pip install -r requirements.txt

COPY app/ ./app/
COPY data/ ./data/
COPY .env.example ./.env.example

RUN mkdir -p /app/data/processed /app/vector_store

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
