# Copy this file to .env and fill in what you have. Every value below has a
# safe default in app/config.py, so the app runs with zero configuration
# (in rule-based fallback mode) -- fill these in to unlock full
# natural-language SQL generation and LLM-grounded RAG answers.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- LLM provider: anthropic | openai | groq | none ---
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Embeddings: sentence-transformers | tfidf ---
# sentence-transformers requires `pip install sentence-transformers` (pulls in torch).
EMBEDDING_BACKEND=tfidf
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Database ---
DATABASE_URL=sqlite:///./data/processed/hospital.db

# --- RAG tuning ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.15

# --- SQL agent ---
SQL_ROW_LIMIT=200
SQL_QUERY_TIMEOUT_SECONDS=10

# --- Cache / memory ---
QUERY_CACHE_TTL_SECONDS=300
QUERY_CACHE_MAX_SIZE=256
CONVERSATION_MEMORY_TURNS=6

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list is not supported by pydantic-settings list parsing from
# plain env vars by default; set CORS_ORIGINS as a JSON array string if you
# need to restrict it, e.g.: CORS_ORIGINS=["https://myapp.com"]
API_KEY=
